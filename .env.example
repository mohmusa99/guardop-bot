# ── WhatsApp / Meta ────────────────────────────────────────────────────────────
WHATSAPP_TOKEN=your_new_access_token_here
PHONE_NUMBER_ID=1163793440147442
BUSINESS_ID=1389693326368002

# Choose any secret string - you'll paste this into Meta dashboard
VERIFY_TOKEN=mysecretverify123

# ── Google ─────────────────────────────────────────────────────────────────────
# Paste the ENTIRE contents of your service account JSON file as one line
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# The long ID from your Google Sheet URL:
# https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
SPREADSHEET_ID=your_spreadsheet_id_here

# Optional: Google Drive folder ID to organise photos
# Leave blank to upload to root Drive
DRIVE_FOLDER_ID=your_folder_id_here
